generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  displayName  String
  passwordHash String

  sessions Session[]
  analyses Analysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Analysis {
  id               String         @id @default(cuid())
  status           AnalysisStatus @default(UPLOADING)
  originalFilename String
  storedFilename   String?
  mimeType         String?
  fileSizeBytes    Int?
  failureReason    String?

  swingScore       Int?
  tempoRatio       Float?
  backswingSeconds Float?
  downswingSeconds Float?
  consistencyScore Int?
  primaryFinding   String?
  recommendation   String?
  phaseTimings     Json?

  analysisPayload Json?
  analysisReport  Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
